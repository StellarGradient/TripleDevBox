<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable, self-contained folder publish (Visual Studio: right-click project →
  Publish, or `dotnet publish -p:PublishProfile=Portable-win-x64`).
  Produces a folder that runs on any Windows 10/11 x64 machine with NO
  prerequisites (.NET runtime and Windows App SDK are both bundled). The csproj
  TrimUnusedWindowsAppSdkComponents target then removes unused ML/AI components.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>dist\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
