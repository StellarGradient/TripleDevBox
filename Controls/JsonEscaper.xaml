<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TripleDevBox.Controls.JsonEscaper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource ToolCardStyle}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="JSON Escape / Unescape" Style="{StaticResource ToolHeaderTextStyle}" />

            <!-- Toolbar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Escape →" Style="{StaticResource AccentButtonStyle}" Click="Escape_Click"
                        ToolTipService.ToolTip="Escape the input so it is safe inside a JSON string" />
                <Button Content="Unescape →" Style="{StaticResource AccentButtonStyle}" Click="Unescape_Click"
                        ToolTipService.ToolTip="Turn escaped JSON string content back into raw text" />
                <AppBarSeparator />
                <Button Content="Copy output" Click="CopyOutput_Click" />
                <Button Content="Swap" Click="Swap_Click"
                        ToolTipService.ToolTip="Move the output back into the input" />
                <Button Content="Clear" Click="Clear_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Input | Output, both fill the remaining height -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Input" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="InputBox"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             PlaceholderText="Paste text here, then press Escape or Unescape." />
                </Grid>

                <Grid Grid.Column="1" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Output" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="OutputBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             PlaceholderText="Result appears here." />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
